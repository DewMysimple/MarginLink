{
  "name": "margin-link",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native Wikilinks visualized in the margins of each Obsidian note.",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "lint": "eslint src tests scripts",
    "package": "npm run build && node scripts/package.mjs",
    "test:desktop": "node scripts/desktop-test.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "globals": "^16.0.0",
    "obsidian": "latest",
    "playwright-core": "^1.56.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.0"
  }
}
